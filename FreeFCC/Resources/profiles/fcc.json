{
  "name": "FCC + 500m",
  "description": "Switches the radio from CE to FCC mode (higher power, 2W vs 0.5W on 2.4GHz, more channels, more range) and sets the altitude ceiling to 500m. The whole sequence runs inside one service-mode window. Written for the DJI RC-N series over the iOS MFi link, and confirmed on an RC-N3.",
  "source": "Frames follow the publicly documented DUML/DUMPL protocol (dji-firmware-tools). The region path and the max-height parameter were verified against the dissector on this hardware: country code US triggers FCC, and g_config.flying_limit.max_height sets the ceiling.",
  "sender": 130,
  "sender_desc": "MOBILE_APP, index 4, the phone/tablet/host app",
  "cmd_type": 32,
  "cmd_type_desc": "Request, ACK_BEFORE_EXEC, no encryption",
  "rounds": 2,
  "inter_frame_delay_ms": 30,
  "inter_round_delay_ms": 100,
  "read_window_ms": 50,
  "repeat_interval_ms": 8000,
  "timing_note": "The whole burst has to land inside the service-mode window opened by frame 1 (AUTOTEST enter) and closed by the last frame (AUTOTEST exit). 30ms per frame puts a full 2-round pass at roughly 1.5s. Stretch it past a few seconds and the radio silently stays on CE.",
  "frames": [
    { "s": 16, "i": 88,  "d": 18,  "p": "030100",             "note": "AUTOTEST set: enter service mode (dst=SVO)" },
    { "s": 6,  "i": 114, "d": 6,   "p": "00000000000100",     "note": "RADIO set region param to FCC (01) (dst=REMOTE_RADIO)" },
    { "s": 3,  "i": 249, "d": 3,   "p": "8a237103f401",       "note": "FLYCONTROLLER write g_config.flying_limit.max_height = 500 (0x01F4), the altitude ceiling" },
    { "s": 3,  "i": 249, "d": 3,   "p": "9ad152ae01",         "note": "FLYCONTROLLER write g_config.advanced_function.height_limit_enabled = 1, enforce the 500m ceiling" },
    { "s": 0,  "i": 0,   "d": 31,  "p": "000001",             "note": "GENERAL activate change (dst=WM330_OR_WM220)" },
    { "s": 0,  "i": 50,  "d": 111, "p": "3131000000",         "note": "GENERAL set country code '11' (dst=LB_68013_SKY idx 3)" },
    { "s": 3,  "i": 175, "d": 3,   "p": "032400000000000000", "note": "FLYCONTROLLER write param (cmd 0xAF)" },
    { "s": 7,  "i": 48,  "d": 9,   "p": "55530000555300000100", "note": "WIFI Set Country Code US 2.4G (US 5553 is the documented FCC trigger)" },
    { "s": 7,  "i": 48,  "d": 9,   "p": "55530000555300000100", "note": "WIFI Set Country Code US 5.8G" },
    { "s": 9,  "i": 39,  "d": 9,   "p": "00024800ffff0200000000", "note": "OFDM set 2.4G power limit (dst=LB_MCU_SKY)" },
    { "s": 9,  "i": 39,  "d": 9,   "p": "00026300ffff0300000000", "note": "OFDM set 5.8G power limit (dst=LB_MCU_SKY)" },
    { "s": 7,  "i": 24,  "d": 7,   "p": "ff555300",           "note": "WIFI write channel map US (dst=WIFI)" },
    { "s": 7,  "i": 25,  "d": 9,   "p": "c0",                 "note": "WIFI set channel flag (dst=LB_MCU_SKY)" },
    { "s": 3,  "i": 249, "d": 146, "p": "d04aeffb01",         "note": "FLYCONTROLLER write param ON (dst=SVO idx 4)" },
    { "s": 3,  "i": 249, "d": 146, "p": "d04aeffb00",         "note": "FLYCONTROLLER write param OFF (dst=SVO idx 4)" },
    { "s": 0,  "i": 229, "d": 111, "p": "323201",             "note": "GENERAL set country code '22' (dst=LB_68013_SKY idx 3)" },
    { "s": 3,  "i": 249, "d": 3,   "p": "236b820101",         "note": "FLYCONTROLLER write param (cmd 0xF9)" },
    { "s": 3,  "i": 249, "d": 3,   "p": "8773e68a01",         "note": "FLYCONTROLLER write param (cmd 0xF9)" },
    { "s": 6,  "i": 140, "d": 9,   "p": "000300",             "note": "RADIO set parameter 03 (dst=LB_MCU_SKY)" },
    { "s": 6,  "i": 140, "d": 9,   "p": "000100",             "note": "RADIO set parameter 01 (dst=LB_MCU_SKY)" },
    { "s": 6,  "i": 114, "d": 6,   "p": "000000000001ff",     "note": "RADIO commit region change (dst=REMOTE_RADIO)" },
    { "s": 16, "i": 88,  "d": 18,  "p": "030100",             "note": "AUTOTEST exit service mode (dst=SVO)" }
