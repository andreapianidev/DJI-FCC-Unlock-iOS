<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>FreeFCC</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>external-accessory</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- Exposes the session log in the Files app, so a hardware test can
	     be read back without a Mac attached. -->
	<!-- The diagnostics probe knocks on a peer address when a USB network
	     interface appears, which iOS treats as local network access. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Checks whether the connected controller exposes itself as a network device, so the app can find a channel to it.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- MFi protocols this build may open a session on.
	     iOS refuses EASession for any protocol not listed here, and worse, it
	     hides the accessory from connectedAccessories entirely, so a wrong
	     list reads exactly like no controller being plugged in at all.

	     The first three are what DJI documents for third-party SDK
	     developers. They are not enough: an RC-N3 stayed invisible with only
	     those while DJI Fly, on the same cable at the same moment, connected
	     fine. logiclink and fly were read out of DJI Fly's own Info.plist on
	     the device and appear in no public DJI documentation:
	       ideviceinstaller list -b com.dji.golite \
	         -a UISupportedExternalAccessoryProtocols -->
	<key>UISupportedExternalAccessoryProtocols</key>
	<array>
		<string>com.dji.logiclink</string>
		<string>com.dji.protocol</string>
		<string>com.dji.common</string>
		<string>com.dji.fly</string>
		<string>com.dji.video</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
